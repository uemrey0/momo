<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime resource access. Momo is not sandboxed because it runs the
	     user's own command line tools (Codex, Gemini CLI) and reads the screen on request. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Only for the Wi-Fi network's name, which macOS shares with apps that have Location. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Covers Reminders as well as calendars. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
