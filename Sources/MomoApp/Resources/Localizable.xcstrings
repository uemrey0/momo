    "Meetings" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantılar"
          }
        }
      }
    },
    "Meetings Momo took notes of show up here, with their summary and action items." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momo'nun not aldığı toplantılar özetleri ve yapılacaklarıyla burada görünür."
          }
        }
      }
    },
    "Meetings are transcribed by the cloud service chosen in Voice, which tells the other speakers apart; Momo asks before each meeting, and you can pick this Mac instead." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantılar Ses bölümünde seçilen bulut hizmetiyle yazıya dökülür ve diğer konuşmacılar birbirinden ayrılır; Momo her toplantıdan önce sorar, istersen bunun yerine bu Mac'i seçebilirsin."
          }
        }
      }
    },
    "Meetings are transcribed on this Mac with the speech recognition chosen in Voice." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantılar bu Mac'te, Ses bölümünde seçilen konuşma tanıma ile yazıya dökülür."
          }
        }
      }
    },
    "Message" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj"
          }
        }
      }
    },
