    },
    "I live in your notch. I keep your tasks, notes and habits, remember what matters to you, and answer questions, privately on your Mac whenever I can." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentiğinde yaşıyorum. Görevlerini, notlarını ve alışkanlıklarını tutar, senin için önemli olanları hatırlar ve sorularını cevaplarım. Elimden geldiğince hepsini gizlice, Mac'inde yaparım."
          }
        }
      }
    },
