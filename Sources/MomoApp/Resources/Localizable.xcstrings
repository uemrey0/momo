      }
    },
    "Apple Intelligence runs on your Mac and needs macOS 26 with Apple Intelligence turned on." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence Mac'inde çalışır; macOS 26 ve açık bir Apple Intelligence gerektirir."
