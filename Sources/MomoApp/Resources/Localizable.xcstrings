            "value" : "Mikrofon"
          }
        }
      }
    },
    "Microphone only" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca mikrofon"
          }
        }
      }
    },
    "Model" : {
      "localizations" : {
