    "Yawn when it gets very late" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok geç olunca esne"
          }
        }
      }
    },
    "You" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen"
          }
        }
      }
    },
    "You have %lld tasks due and %lld events today. Want me to plan your day?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün %lld görevin ve %lld etkinliğin var. Gününü planlamamı ister misin?"
          }
        }
      }
    },
    "You pay the provider for what you use. Keys stay in your Keychain." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullandığın kadarını sağlayıcıya ödersin. Anahtarlar Anahtar Zinciri'nde kalır."
          }
        }
      }
    },
    "You picked this brain for our conversation." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet için bu beyni sen seçtin."
          }
        }
      }
