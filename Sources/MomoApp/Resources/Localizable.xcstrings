        }
      }
    },
    "Anthropic doesn't let other apps use Claude plans, but Claude can use Momo: connect them and Claude can read and update your tasks, notes and memories." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic, Claude planlarının başka uygulamalarda kullanılmasına izin vermiyor ama Claude Momo'yu kullanabilir: ikisini bağla, Claude görevlerini, notlarını ve anılarını okuyup güncelleyebilsin."
          }
        }
      }
    },
    "Anthropic's models, with an API key." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic'in modelleri, API anahtarıyla."
          }
        }
      }
    },
    "Apple Intelligence is on. Momo uses it for quick, private answers." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence açık. Momo onu hızlı ve gizli yanıtlar için kullanıyor."
